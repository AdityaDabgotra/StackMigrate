# --- LLM ---
ANTHROPIC_API_KEY=

# --- API security (required) ---
# A long random secret; clients send it as the X-API-Key header on every /migrations call.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
STACKMIGRATE_API_KEY=
# Local development ONLY (never in a deployment): STACKMIGRATE_ALLOW_NO_AUTH=1 turns authentication off.

# --- Persistence ---
# Used by docker compose to create the database and build MIGRATION_DB_URL for the containers.
POSTGRES_PASSWORD=
MIGRATION_DB_URL=postgresql://stackmigrate:stackmigrate@localhost:5432/stackmigrate

# --- Work directory ---
# Where run checkouts live. With docker compose it must be the same absolute path on the host and
# in the worker (sandbox containers are siblings started by the host daemon). Create it first.
STACKMIGRATE_WORK_DIR=/var/lib/stackmigrate/work

# --- Queue ---
REDIS_URL=redis://localhost:6379/0

# --- GitHub integration (used from Step 6 onward) ---
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# --- Budget defaults (overridable per-run via API) ---
DEFAULT_MAX_USD_PER_RUN=5.00
DEFAULT_MAX_LLM_CALLS_PER_RUN=500
DEFAULT_MAX_WALL_CLOCK_SECONDS=3600

# --- Observability (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=stackmigrate
